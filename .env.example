# Most of these can also be changed from the Settings page (administrators); what is saved
# there replaces the value below. SECRET_KEY, BASE_URL, DATA_DIR and TZ are only read from here.
SECRET_KEY=change-me   # set a long random value; the app refuses to start in production with this one
TZ=Europe/Rome
PUID=1000
PGID=1000
BASE_URL=http://localhost:8080
MB_USER_AGENT=Diskko/0.1 ( you@example.com )  # required for MusicBrainz: name/version + a contact
LASTFM_API_KEY=
PLEX_URL=
PLEX_TOKEN=
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
# SLSKD_MODE=auto            # auto: best candidate; manual: the user picks one
# SLSKD_SEARCH_TIMEOUT=30    # seconds without a new answer before a search ends
# SLSKD_CANDIDATES=5         # candidates kept (and shown for a manual choice)
# SLSKD_STALL_MINUTES=10     # no data for this long: try the next candidate
# SLSKD_QUEUE_MINUTES=120    # waiting this long in the remote queue: try the next one
# SLSKD_MAX_HOURS=12         # one candidate may take this long at most
# SLSKD_FILE_RETRIES=2       # a failed file is asked again this many times
PORT=8080              # development; the Compose file sets 8000 for the container
DATA_DIR=./data
MUSIC_DIR=./music-test
DOWNLOADS_DIR=./downloads-test
# LOG_FORMAT=text       # json in the container image: one object per line
# LOG_LEVEL=INFO
# ENV=production        # refuses to start with the default SECRET_KEY
# SESSION_TTL_HOURS=336
# Job engine
# JOBS_ENABLED=true
# JOB_QUEUE_CONCURRENCY=default:2,musicbrainz:1,slskd:6,library:1,coverart:2,discovery:2   # musicbrainz is always 1; unlisted queues get 1
# JOB_RETENTION_ROUTINE_DAYS=1   # service checks and the cleanup (at least 1)
# JOB_RETENTION_SUCCESS_DAYS=14  # every other job that succeeded or was cancelled
# JOB_RETENTION_FAILED_DAYS=60   # every other job that failed
# JOB_RETENTION_OVERRIDES=       # per job type, e.g. scan_library:90,fetch_covers:7
# Library
# LIBRARY_SOURCE=filesystem            # or: plex
# LIBRARY_SCAN_CRON=0 2 * * *          # nightly scan; empty = disabled
# LIBRARY_MAX_REMOVAL_PCT=50           # abort a scan that would drop more of the known tracks
# PLEX_MUSIC_SECTION=Music             # Plex source: name of the music library section
# LIBRARY_PATH_MAP=/data/music=/music  # Plex source: "plex_prefix=local_prefix;..."
# MusicBrainz / Cover Art Archive
# MB_CACHE_TTL_DAYS=7        # answers are cached in the database
# MB_REFRESH_DAYS=30         # re-sync artists whose metadata is older than this
# MB_MIN_INTERVAL=1.1        # seconds between requests; MusicBrainz allows 1 per second, do not go lower
# COVERART_ENABLED=true      # download front covers into DATA_DIR/covers
# DEFAULT_QUALITY=flac_standard   # key of a quality profile (see Settings > Quality)
# MIN_PASSWORD_LENGTH=8
# STATUS_CHECK_MINUTES=5     # how often the services are checked (status icon); 0 = never
# LASTFM_API_KEY=            # similar artists (free key); ListenBrainz is the fallback
# PREVIEW_COUNTRY=US         # iTunes catalogue used for previews
# Sign-in brake: failed attempts inside the window pause the account / the address
# LOGIN_MAX_ATTEMPTS=5          # per account name (0 = off)
# LOGIN_MAX_ATTEMPTS_IP=20      # per address, any account name
# LOGIN_WINDOW_SECONDS=300
# TRUST_PROXY=false             # true only behind a reverse proxy that sets X-Forwarded-For
# TRUST_PROXY_HOPS=1            # proxies in front that each append to it (the address counted is the last)
# Database backups (data/backups, also in Settings > Backups)
# BACKUP_CRON=15 3 * * *        # nightly; empty = off
# BACKUP_KEEP=7                 # copies to keep
# An upgrade deletes the old copy of the album; true moves its files to <music>/.diskko-replaced
# KEEP_REPLACED=false
